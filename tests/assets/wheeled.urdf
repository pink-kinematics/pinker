<?xml version="1.0"?>
<!-- Synthetic robot with continuous, prismatic, revolute and fixed joints, unaligned axes, and non-trivial origins. -->
<robot name="wheeled">
  <link name="base">
    <inertial>
      <origin xyz="0.01 -0.02 0.05" rpy="0.1 0.2 0.3"/>
      <mass value="4.2"/>
      <inertia ixx="0.1" ixy="0.001" ixz="0.002" iyy="0.2" iyz="0.003" izz="0.3"/>
    </inertial>
  </link>
  <link name="left_wheel">
    <inertial>
      <origin xyz="0 0 0.01"/>
      <mass value="0.6"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.02" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <link name="right_wheel">
    <inertial>
      <mass value="0.6"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.02" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <link name="mast"/>
  <link name="slider">
    <inertial>
      <origin xyz="0 0.03 0"/>
      <mass value="1.1"/>
      <inertia ixx="0.02" iyy="0.02" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <link name="head">
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <link name="antenna"/>
  <joint name="left_wheel_joint" type="continuous">
    <origin xyz="0 0.2 0" rpy="-1.5708 0 0"/>
    <parent link="base"/>
    <child link="left_wheel"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="8"/>
  </joint>
  <joint name="right_wheel_joint" type="continuous">
    <origin xyz="0 -0.2 0" rpy="1.5708 0 0"/>
    <parent link="base"/>
    <child link="right_wheel"/>
    <axis xyz="0 0 -1"/>
    <limit effort="10" velocity="8"/>
  </joint>
  <joint name="mast_joint" type="fixed">
    <origin xyz="0.1 0 0.3" rpy="0 0.1 0"/>
    <parent link="base"/>
    <child link="mast"/>
  </joint>
  <joint name="slider_joint" type="prismatic">
    <origin xyz="0 0 0.2"/>
    <parent link="mast"/>
    <child link="slider"/>
    <axis xyz="0.267261 0.534522 0.801784"/>
    <limit lower="-0.5" upper="0.7" effort="20" velocity="1.5"/>
  </joint>
  <joint name="head_joint" type="revolute">
    <origin xyz="0 0 0.1" rpy="0.2 -0.1 0.05"/>
    <parent link="slider"/>
    <child link="head"/>
    <axis xyz="1 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="5" velocity="3"/>
  </joint>
  <joint name="antenna_joint" type="fixed">
    <origin xyz="0 0 0.15"/>
    <parent link="head"/>
    <child link="antenna"/>
  </joint>
</robot>
