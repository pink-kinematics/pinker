        <joint name="joint1"/>
        <inertial pos="0 0 0.05" mass="0.2" diaginertia="0.000177083 0.000177083 0.000020833"/>
        <geom pos="0 0 0.05" size="0.0125 0.0125 0.05" rgba="0 1 0 1"/>
        <body name="link2" pos="0.0125 0 0.1">
          <joint name="joint2"/>
          <inertial pos="0 0 0.1" mass="0.3" diaginertia="0.001015625 0.001015625 0.002"/>
          <geom pos="0 0 0.1" size="0.0125 0.0125 0.1" rgba="0 0 1 1"/>
          <site name="tip" pos="0 0 0.2"/>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
